---
// Marca del producto: tres volúmenes (edificios) dentro de una tesela redondeada.
interface Props {
  name: string;
  tone?: 'night' | 'light';
  size?: 'sm' | 'md' | 'lg';
}

const { name, tone = 'light', size = 'md' } = Astro.props;
const box = size === 'lg' ? 44 : size === 'sm' ? 30 : 36;
---

<span class="inline-flex items-center gap-3">
  <svg width={box} height={box} viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="11" fill={tone === 'night' ? 'var(--color-glow)' : 'var(--color-accent)'}></rect>
    <g fill={tone === 'night' ? 'var(--color-night)' : 'var(--color-on-accent)'}>
      <rect x="9" y="17" width="6" height="14" rx="1.5"></rect>
      <rect x="17" y="10" width="6" height="21" rx="1.5"></rect>
      <rect x="25" y="20" width="6" height="11" rx="1.5"></rect>
    </g>
  </svg>
  <span
    class:list={[
      'font-display font-semibold leading-none',
      size === 'lg' ? 'text-2xl' : size === 'sm' ? 'text-base' : 'text-xl',
      tone === 'night' ? 'text-night-ink' : 'text-ink',
    ]}
  >
    {name}
  </span>
</span>
