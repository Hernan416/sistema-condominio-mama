---
// Campo grande y legible. El slot "trailing" admite una acción dentro del campo (p. ej. mostrar PIN).
import type { HTMLAttributes } from 'astro/types';

type Props = {
  id: string;
  label: string;
  hint?: string;
  invalid?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'input'>, 'id' | 'class'>;

const { id, label, hint, invalid = false, class: className, ...inputProps } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const hasTrailing = Astro.slots.has('trailing');
---

<div class="flex flex-col gap-2">
  <label for={id} class="text-lg font-bold">{label}</label>
  <div class="relative">
    <input
      id={id}
      aria-describedby={hintId}
      aria-invalid={invalid ? 'true' : undefined}
      class:list={[
        'min-h-16 w-full rounded-[var(--radius-control)] border-2 bg-surface px-5 text-2xl font-bold text-ink',
        'shadow-[inset_0_1px_2px_rgb(15_26_21/0.04)] transition-[border-color,box-shadow] duration-200',
        'placeholder:font-normal placeholder:text-ink-muted/60',
        'hover:border-line-strong focus:border-accent focus:shadow-[0_0_0_4px_var(--color-accent-tint)] focus:outline-none',
        invalid ? 'border-danger' : 'border-line',
        hasTrailing && 'pr-16',
        className,
      ]}
      {...inputProps}
    />
    {hasTrailing && (
      <div class="absolute inset-y-0 right-2 flex items-center">
        <slot name="trailing" />
      </div>
    )}
  </div>
  {hint && <p id={hintId} class="text-base text-ink-muted">{hint}</p>}
</div>
