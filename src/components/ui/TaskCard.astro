---
// Tarjeta de tarea: un botón grande con icono, título en verbo ("Anotar un pago") y una
// frase que explica cuándo usarla. Toda la tarjeta es el enlace (objetivo grande).
import Icon, { type IconName } from '@/components/ui/Icon.astro';

interface Props {
  href: string;
  icon: IconName;
  title: string;
  description: string;
  /** Estado corto opcional ("Falta anotar los gastos", "Listo"). */
  status?: string | null;
  statusTone?: 'default' | 'warning' | 'done';
  /** La tarea más importante se destaca en color. */
  primary?: boolean;
}

const { href, icon, title, description, status = null, statusTone = 'default', primary = false } = Astro.props;
const statusClass = { default: 'bg-sunken text-ink', warning: 'bg-warning-tint text-warning', done: 'bg-accent-tint text-accent-strong' }[statusTone];
---

<a
  href={href}
  class:list={[
    'group flex min-h-40 flex-col gap-3 rounded-[var(--radius-card)] p-6 no-underline shadow-[var(--shadow-raised)] ring-1 transition-[transform,box-shadow] hover:-translate-y-0.5 focus-visible:ring-4',
    primary ? 'bg-accent text-on-accent ring-accent' : 'bg-surface text-ink ring-line hover:ring-line-strong',
  ]}
>
  <span class="flex items-start justify-between gap-3">
    <span class:list={['inline-flex size-14 shrink-0 items-center justify-center rounded-2xl', primary ? 'bg-white/15' : 'bg-accent-tint text-accent-strong']}>
      <Icon name={icon} size={30} />
    </span>
    {status && <span class:list={['rounded-full px-3 py-1 text-sm font-bold', primary ? 'bg-white/20 text-on-accent' : statusClass]}>{status}</span>}
  </span>
  <span class="font-display text-2xl font-semibold">{title}</span>
  <span class:list={['text-base', primary ? 'text-on-accent/90' : 'text-ink-muted']}>{description}</span>
  <span class="mt-auto inline-flex items-center gap-1.5 text-base font-bold">
    Entrar <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
  </span>
</a>
