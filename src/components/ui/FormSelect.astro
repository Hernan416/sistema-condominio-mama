---
// Select compacto para formularios del panel.
interface Props {
  id: string;
  name: string;
  label: string;
  value?: string | null;
  options: { value: string; label: string }[];
  hint?: string;
  class?: string;
}

const { id, name, label, value, options, hint, class: className } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class:list={['flex flex-col gap-1.5', className]}>
  <label for={id} class="text-sm font-bold text-ink-muted">{label}</label>
  <div class="relative">
    <select
      id={id}
      name={name}
      aria-describedby={hintId}
      class="min-h-11 w-full cursor-pointer appearance-none rounded-xl bg-surface pl-3 pr-9 text-base text-ink ring-1 ring-inset ring-line hover:ring-line-strong focus:outline-none focus:ring-2 focus:ring-accent"
    >
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <svg class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
  </div>
  {hint && <p id={hintId} class="text-xs text-ink-muted">{hint}</p>}
</div>
