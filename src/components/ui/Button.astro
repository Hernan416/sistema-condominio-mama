---
// Botón puro de presentación. Renderiza <a> si recibe `href`, si no <button>.
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg' | 'xl';

type Props = {
  variant?: Variant;
  size?: Size;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> &
  Omit<HTMLAttributes<'a'>, 'class' | 'type'>;

const { variant = 'primary', size = 'lg', href, class: className, ...rest } = Astro.props;

const base =
  'group inline-flex cursor-pointer items-center justify-center gap-3 rounded-[var(--radius-control)] font-bold no-underline ' +
  'transition-[background-color,box-shadow,transform,border-color] duration-300 ease-[var(--ease-out-expo)] ' +
  'active:scale-[0.985] disabled:cursor-not-allowed disabled:opacity-60';

const variants: Record<Variant, string> = {
  primary: 'bg-accent text-on-accent shadow-[var(--shadow-button)] hover:bg-accent-strong',
  secondary: 'border-2 border-line bg-surface text-ink hover:border-line-strong',
  ghost: 'text-ink-muted hover:bg-sunken hover:text-ink',
};

const sizes: Record<Size, string> = {
  md: 'min-h-12 px-4 text-base',
  lg: 'min-h-16 w-full px-6 text-xl',
  xl: 'min-h-24 w-full px-8 text-2xl leading-tight',
};

const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
    </button>
  )
}
