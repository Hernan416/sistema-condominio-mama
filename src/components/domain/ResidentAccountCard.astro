---
// Estado de cuenta del residente: letra grande, sin tablas, solo lectura.
import Icon from '@/components/ui/Icon.astro';
import type { ResidentAccountView } from '@/adapters/residentAccountViewAdapter';

interface Props {
  account: ResidentAccountView;
}

const { account } = Astro.props;
---

<section aria-labelledby="account-heading" class="mt-6 rounded-[var(--radius-card)] bg-surface p-6 shadow-[var(--shadow-raised)] ring-1 ring-line sm:p-10">
  <h2 id="account-heading" class="font-display mb-5 text-3xl font-semibold">Mi estado de cuenta</h2>

  {
    account.upToDate ? (
      <p class="flex items-center gap-3 text-2xl font-bold text-accent">
        <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-accent-tint">
          <Icon name="check" size={28} strokeWidth={3} />
        </span>
        Está al día. ¡Gracias!
      </p>
    ) : (
      <div class="flex flex-col gap-1">
        <p class="text-xl text-ink-muted">Total que debe hoy</p>
        <p class="font-display text-5xl font-semibold text-warning">{account.outstandingLabel}</p>
        {account.outstandingVesLabel && <p class="text-2xl font-bold">{account.outstandingVesLabel}</p>}
      </div>
    )
  }

  {account.creditLabel && <p class="mt-4 rounded-[var(--radius-control)] bg-accent-tint px-5 py-3 text-xl font-bold text-accent-strong">Tiene {account.creditLabel} a favor para el próximo recibo.</p>}

  {
    account.pending.length > 0 && (
      <div class="mt-8">
        <h3 class="mb-3 text-xl font-bold">Lo que falta por pagar</h3>
        <ul class="flex flex-col divide-y divide-line">
          {account.pending.map((c) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
              <span>
                <span class="block text-xl">{c.label}</span>
                {c.paidLabel && <span class="text-lg text-ink-muted">Ya abonó {c.paidLabel}</span>}
              </span>
              <span class="tabular text-xl font-bold">{c.amountLabel}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="mt-8">
    <h3 class="mb-3 text-xl font-bold">Mis últimos pagos</h3>
    {
      account.payments.length === 0 ? (
        <p class="text-xl text-ink-muted">Todavía no hay pagos registrados.</p>
      ) : (
        <ul class="flex flex-col divide-y divide-line">
          {account.payments.map((p) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
              <span>
                <span class="block text-xl">{p.dateLabel}</span>
                <span class="text-lg text-ink-muted">{p.methodLabel}</span>
              </span>
              <span class="tabular text-xl font-bold">{p.amountLabel}</span>
            </li>
          ))}
        </ul>
      )
    }
    <p class="mt-4 text-lg text-ink-muted">Si pagó y no aparece aquí, envíe el comprobante a la administración.</p>
  </div>
</section>
