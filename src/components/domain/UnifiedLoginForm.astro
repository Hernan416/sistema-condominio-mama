---
// Un solo formulario para todos: usuario + PIN (la administradora y los residentes).
// Funciona sin JavaScript; el script solo agrega el botón "mostrar PIN".
import Alert from '@/components/ui/Alert.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import TextField from '@/components/ui/TextField.astro';

export type LoginError = 'invalid' | 'locked' | 'format' | 'server' | 'expired';

interface Props {
  error?: LoginError | null;
  identifier?: string;
}

const { error = null, identifier = '' } = Astro.props;

const messages: Record<LoginError, { tone: 'danger' | 'warning'; text: string }> = {
  invalid: { tone: 'danger', text: 'El usuario o el PIN no coinciden. Revíselos e intente de nuevo.' },
  locked: { tone: 'warning', text: 'Por seguridad, el acceso está pausado 15 minutos. Intente más tarde o llame a la administración.' },
  format: { tone: 'danger', text: 'Escriba su usuario y su PIN.' },
  server: { tone: 'danger', text: 'No pudimos entrar en este momento. Intente de nuevo en unos minutos.' },
  expired: { tone: 'warning', text: 'Su sesión terminó. Vuelva a entrar.' },
};
const invalid = error === 'invalid' || error === 'format';
---

<form method="post" action="/api/auth/login" class="flex flex-col gap-7" data-login-form novalidate>
  {error && <Alert tone={messages[error].tone}>{messages[error].text}</Alert>}

  <TextField
    id="identifier"
    name="identifier"
    label="Usuario"
    hint="Ejemplo: 3b-12"
    value={identifier}
    autocomplete="username"
    autocapitalize="none"
    spellcheck="false"
    maxlength={120}
    required
    invalid={invalid}
    data-identifier
  />

  <TextField
    id="secret"
    name="secret"
    type="password"
    label="PIN"
    hint="Sus 4 números."
    autocomplete="current-password"
    inputmode="numeric"
    maxlength={4}
    required
    invalid={invalid}
    data-secret
  >
    <button
      slot="trailing"
      type="button"
      class="inline-flex size-12 cursor-pointer items-center justify-center rounded-[0.625rem] text-ink-muted transition-colors hover:bg-sunken hover:text-ink"
      aria-label="Mostrar PIN"
      aria-pressed="false"
      data-reveal
    >
      <Icon name="eye" size={24} class="reveal-show" />
      <Icon name="eye-off" size={24} class="reveal-hide hidden" />
    </button>
  </TextField>

  <Button type="submit" size="lg">
    Entrar
    <Icon name="arrow-right" size={24} class="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
  </Button>

  <p class="text-lg text-ink-muted">¿Olvidó su PIN? Comuníquese con la administración de su conjunto.</p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-login-form]')) {
    const secret = form.querySelector<HTMLInputElement>('[data-secret]');
    const reveal = form.querySelector<HTMLButtonElement>('[data-reveal]');
    if (!secret) continue;

    reveal?.addEventListener('click', () => {
      const show = secret.type === 'password';
      secret.type = show ? 'text' : 'password';
      reveal.setAttribute('aria-pressed', String(show));
      reveal.setAttribute('aria-label', show ? 'Ocultar PIN' : 'Mostrar PIN');
      reveal.querySelector('.reveal-show')?.classList.toggle('hidden', show);
      reveal.querySelector('.reveal-hide')?.classList.toggle('hidden', !show);
      secret.focus();
    });
  }
</script>
