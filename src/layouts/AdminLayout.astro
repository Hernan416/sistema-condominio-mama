---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdminNav from '@/components/domain/AdminNav.astro';
import type { Condominium } from '@/types/domain';

interface Props {
  title: string;
  appName: string;
  adminEmail: string | null;
  condominiums: Condominium[];
  activeSlug?: string | null;
}

const { title, appName, adminEmail, condominiums, activeSlug = null } = Astro.props;
---

<BaseLayout title={`${title} · ${appName}`}>
  <div class="lg:grid lg:min-h-dvh lg:grid-cols-[14.5rem_minmax(0,1fr)]">
    <AdminNav appName={appName} adminEmail={adminEmail} condominiums={condominiums} activeSlug={activeSlug} />
    <main class="min-w-0 px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <div class="mx-auto max-w-[76rem] animate-rise">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
