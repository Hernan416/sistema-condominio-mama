---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandMark from '@/components/ui/BrandMark.astro';
import Icon from '@/components/ui/Icon.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';

interface Props {
  title: string;
  appName: string;
}

const { title, appName } = Astro.props;
---

<BaseLayout title={`${title} · ${appName}`}>
  <div class="flex min-h-dvh flex-col">
    <header class="on-night night-texture text-night-ink">
      <div class="mx-auto flex w-full max-w-2xl items-center justify-between gap-4 px-5 py-5">
        <BrandMark name={appName} tone="night" />
        <div class="flex items-center gap-1">
          <ThemeToggle tone="night" />
          <form method="post" action="/api/auth/logout">
            <button
              type="submit"
              class="inline-flex min-h-12 cursor-pointer items-center gap-2 rounded-full px-4 text-lg font-bold text-night-muted transition-colors hover:bg-night-raised hover:text-night-ink"
            >
              <Icon name="logout" size={20} />
              Salir
            </button>
          </form>
        </div>
      </div>
      <div class="mx-auto w-full max-w-2xl px-5 pb-24 pt-4">
        <slot name="hero" />
      </div>
    </header>

    <main class="mx-auto -mt-16 w-full max-w-2xl flex-1 px-5 pb-16 text-xl leading-relaxed">
      <slot />
    </main>
  </div>
</BaseLayout>
