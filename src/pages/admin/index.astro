---
import AdminLayout from '@/layouts/AdminLayout.astro';
import CondominiumOverviewList from '@/components/domain/CondominiumOverviewList.astro';
import Greeting from '@/components/ui/Greeting.astro';
import ExchangeRateBadge from '@/components/domain/ExchangeRateBadge.astro';
import { getAppName, getCondominiumService, getExchangeRates } from '@/services/container';
import { toExchangeRateView } from '@/adapters/exchangeRateViewAdapter';
import { toCondominiumOverviewView } from '@/adapters/condominiumViewAdapter';

const admin = Astro.locals.admin!;
// Cada condominio tiene su propio "mes de trabajo" (ver `defaultWorkingPeriod`), así que no hay
// un único periodo para todos: el resumen de abajo lo muestra condominio por condominio.
const [overview, rate] = await Promise.all([
  getCondominiumService().overviewForAdmin(admin),
  getExchangeRates().current(),
]);
const condominiums = overview.map((o) => o.condominium);
const pending = overview.reduce((sum, o) => sum + o.pendingCount, 0);
---

<AdminLayout title="Sus condominios" appName={getAppName()} adminUsername={admin.username} condominiums={condominiums}>
  <header class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xl font-bold text-accent">¡Bienvenida{admin.name ? `, ${admin.name}` : ''}!</p>
      <h1 class="font-display mt-1 text-4xl font-semibold sm:text-5xl"><Greeting name={null} />. Estos son sus condominios</h1>
      <p class="mt-3 text-lg text-ink-muted">
        Toque el condominio con el que quiere trabajar.{' '}
        {pending === 0 ? 'Todos los recibos del mes están listos.' : `Faltan ${pending} recibos por emitir en total.`}
      </p>
    </div>
    <ExchangeRateBadge rate={toExchangeRateView(rate)} />
  </header>

  <CondominiumOverviewList items={overview.map((o) => toCondominiumOverviewView(o, rate))} />
</AdminLayout>
