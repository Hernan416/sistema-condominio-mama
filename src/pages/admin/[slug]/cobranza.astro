---
import AdminLayout from '@/layouts/AdminLayout.astro';
import CondominiumHeader from '@/components/domain/CondominiumHeader.astro';
import SummaryStrip from '@/components/ui/SummaryStrip.astro';
import FormSelect from '@/components/ui/FormSelect.astro';
import Button from '@/components/ui/Button.astro';
import Disclosure from '@/components/ui/Disclosure.astro';
import { getAccountService, getAppName, getMetricsService } from '@/services/container';
import { loadAdminCondominiumPage } from '@/services/condominiums/adminPage';
import { chargeHistory, paymentHistory, yearsWithActivity, type ChargeFilter } from '@/services/accounts/collectionHistory';
import { toExchangeRateView } from '@/adapters/exchangeRateViewAdapter';
import { PAYMENT_METHOD_LABELS } from '@/types/accounts';
import { formatUsd, formatVes } from '@/utils/currency';
import { formatDateVe } from '@/utils/dates';
import { adminInvoicePdfPath } from '@/utils/invoiceNaming';
import { allMonths, currentPeriod } from '@/utils/months';

const page = await loadAdminCondominiumPage(Astro);
if (page instanceof Response) return page;
const { admin, condominium, condominiums, rate } = page;

const accounts = [...(await getAccountService().accountsFor(condominium.id)).values()];
const q = Astro.url.searchParams;
const view = (['pagos', 'caja'].includes(q.get('vista') ?? '') ? q.get('vista') : 'recibos') as 'recibos' | 'pagos' | 'caja';
const status = (['all', 'pending', 'partial', 'paid'].includes(q.get('estado') ?? '') ? q.get('estado') : 'all') as ChargeFilter;

const today = currentPeriod();
// Años con movimientos + el actual (aunque todavía no tenga ninguno), para que siempre se pueda elegir.
const years = [...new Set([String(today.year), ...yearsWithActivity(accounts)])].sort().reverse();

const rawMonth = Number(q.get('mes'));
const month = Number.isInteger(rawMonth) && rawMonth >= 1 && rawMonth <= 12 ? rawMonth : null;
// "Ingresos y egresos" siempre necesita un mes concreto; en las otras vistas, el mes (si se
// eligió) también obliga a fijar un año, para no filtrar "septiembre de cualquier año".
let year = years.includes(q.get('anio') ?? '') ? q.get('anio') : null;
if (!year && (month || view === 'caja')) year = String(today.year);
const houseId = accounts.some((a) => a.house.id === q.get('casa')) ? q.get('casa') : null;

const charges = chargeHistory(accounts, { status, year, month, houseId });
const payments = paymentHistory(accounts, { year, month, houseId });
const vesCount = payments.rows.filter((r) => r.payment.amountVes !== null).length;

const cashFlowMonth = month ?? today.month;
const cashFlowYear = Number(year ?? today.year);
const cashFlow = view === 'caja' ? await getMetricsService().monthlyCashFlow(condominium, { month: cashFlowMonth, year: cashFlowYear }) : null;

const date = (d: string) => formatDateVe(new Date(`${d}T12:00:00-04:00`));
const th = 'px-4 py-3 text-left text-xs font-bold uppercase tracking-[0.08em] text-ink-muted';
const statusView = {
  paid: { label: 'Pagado', cls: 'bg-accent-tint text-accent-strong' },
  partial: { label: 'Abono parcial', cls: 'bg-warning-tint text-warning' },
  unpaid: { label: 'Pendiente', cls: 'bg-warning-tint text-warning' },
};
const link = (params: Record<string, string | null>) => {
  const u = new URLSearchParams();
  const merged = { vista: view, estado: status, anio: year, mes: month ? String(month) : null, casa: houseId, ...params };
  for (const [k, v] of Object.entries(merged)) if (v && v !== 'all') u.set(k, v);
  return `?${u}`;
};
const monthOptions = allMonths();
const cashFlowPdfHref = `/api/admin/${condominium.slug}/ingresos-egresos?month=${cashFlowMonth}&year=${cashFlowYear}`;
---

<AdminLayout title={`Historial · ${condominium.name}`} appName={getAppName()} adminUsername={admin.username} condominiums={condominiums} activeSlug={condominium.slug} activeTab="cobranza">
  <CondominiumHeader
    name={condominium.name}
    slug={condominium.slug}
    city={condominium.city}
    active="cobranza"
    rate={toExchangeRateView(rate)}
    description="Aquí se consulta, no se cambia nada: qué recibos están pagados o pendientes, los pagos recibidos y los ingresos y egresos de cada mes."
  />

  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <nav aria-label="Vista" class="flex gap-1 rounded-2xl bg-sunken p-1 ring-1 ring-inset ring-line">
        {
          [
            { id: 'recibos', label: 'Recibos y deudas' },
            { id: 'pagos', label: 'Pagos recibidos' },
            { id: 'caja', label: 'Ingresos y egresos' },
          ].map((v) => (
            <a
              href={link({ vista: v.id })}
              aria-current={view === v.id ? 'page' : undefined}
              class:list={['inline-flex min-h-10 items-center rounded-xl px-4 text-sm font-bold no-underline', view === v.id ? 'bg-surface text-ink shadow-[var(--shadow-raised)] ring-1 ring-line' : 'text-ink-muted hover:text-ink']}
            >
              {v.label}
            </a>
          ))
        }
      </nav>

      <form method="get" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="vista" value={view} />
        {view === 'recibos' && (
          <FormSelect
            id="f-estado"
            name="estado"
            label="Estado"
            value={status}
            options={[
              { value: 'all', label: 'Todos' },
              { value: 'pending', label: 'Con saldo pendiente' },
              { value: 'partial', label: 'Abono parcial' },
              { value: 'paid', label: 'Pagados' },
            ]}
          />
        )}
        <FormSelect
          id="f-mes"
          name="mes"
          label="Mes"
          value={month ? String(month) : ''}
          options={view === 'caja' ? monthOptions.map((m) => ({ value: String(m.value), label: m.label })) : [{ value: '', label: 'Todos los meses' }, ...monthOptions.map((m) => ({ value: String(m.value), label: m.label }))]}
        />
        <FormSelect
          id="f-anio"
          name="anio"
          label="Año"
          value={year ?? ''}
          options={view === 'caja' ? years.map((y) => ({ value: y, label: y })) : [{ value: '', label: 'Todos' }, ...years.map((y) => ({ value: y, label: y }))]}
        />
        {view !== 'caja' && (
          <FormSelect id="f-casa" name="casa" label="Casa" value={houseId ?? ''} options={[{ value: '', label: 'Todas' }, ...accounts.map((a) => ({ value: a.house.id, label: `Casa ${a.house.number}` }))]} />
        )}
        <Button type="submit" size="md" variant="secondary">Filtrar</Button>
      </form>
    </div>

    {
      view === 'recibos' ? (
        <>
          <SummaryStrip
            items={[
              { label: 'Cargos', value: String(charges.totals.count), hint: `${charges.totals.paidCount} ${charges.totals.paidCount === 1 ? 'pagado' : 'pagados'}` },
              { label: 'Facturado', value: formatUsd(charges.totals.charged) },
              { label: 'Cobrado', value: formatUsd(charges.totals.paid), tone: 'accent' },
              { label: 'Pendiente', value: formatUsd(charges.totals.outstanding), tone: charges.totals.outstanding > 0 ? 'warning' : 'default' },
            ]}
          />
          <div class="relative overflow-x-auto rounded-[var(--radius-card)] bg-surface shadow-[var(--shadow-raised)] ring-1 ring-line">
            <table class="w-full min-w-[720px] text-base">
              <thead class="bg-canvas/60">
                <tr class="border-b border-line">
                  <th scope="col" class={th}>Casa</th>
                  <th scope="col" class={th}>Concepto</th>
                  <th scope="col" class={th}>Último pago</th>
                  <th scope="col" class={`${th} text-right`}>Monto</th>
                  <th scope="col" class={`${th} text-right`}>Pendiente</th>
                  <th scope="col" class={th}>Estado</th>
                </tr>
              </thead>
              <tbody>
                {charges.rows.length === 0 && (
                  <tr><td colspan="6" class="p-8 text-center text-ink-muted">No hay cargos con estos filtros.</td></tr>
                )}
                {charges.rows.map(({ house, charge: c, lastPaidOn }) => (
                  <tr class="border-b border-line last:border-b-0 hover:bg-canvas/50">
                    <td class="whitespace-nowrap px-4 py-3">
                      <a href={`/admin/${condominium.slug}/casas/${house.id}`} class="font-bold text-ink no-underline hover:underline">Casa {house.number}</a>
                      <span class="block max-w-44 truncate text-xs text-ink-muted">{house.ownerName ?? ''}</span>
                    </td>
                    <td class="px-4 py-3">
                      <span class="font-bold">{c.label}</span>
                      {c.invoice && <a href={adminInvoicePdfPath(c.invoice.id)} target="_blank" rel="noopener" class="ml-2 text-xs font-bold text-accent underline">PDF</a>}
                      <span class="block text-xs text-ink-muted">{c.source === 'debt' ? `Deuda registrada · desde el ${date(c.date)}` : 'Recibo mensual'}</span>
                    </td>
                    <td class="tabular whitespace-nowrap px-4 py-3 text-sm">{lastPaidOn ? <span class="font-bold">{date(lastPaidOn)}</span> : <span class="text-ink-muted">Sin pagos</span>}</td>
                    <td class="tabular whitespace-nowrap px-4 py-3 text-right font-bold">{formatUsd(c.amount)}</td>
                    <td class:list={['tabular whitespace-nowrap px-4 py-3 text-right font-bold', c.outstanding > 0 ? 'text-warning' : 'text-ink-muted']}>{formatUsd(c.outstanding)}</td>
                    <td class="px-4 py-3"><span class:list={['inline-flex whitespace-nowrap rounded-full px-3 py-1 text-sm font-bold', statusView[c.status].cls]}>{statusView[c.status].label}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : view === 'pagos' ? (
        <>
          <SummaryStrip
            items={[
              { label: 'Pagos', value: String(payments.rows.length) },
              { label: 'Total recibido', value: formatUsd(payments.total), tone: 'accent' },
              { label: 'En bolívares', value: String(vesCount), hint: vesCount === 1 ? 'pago convertido a USD' : 'pagos convertidos a USD' },
            ]}
          />
          <div class="relative overflow-x-auto rounded-[var(--radius-card)] bg-surface shadow-[var(--shadow-raised)] ring-1 ring-line">
            <table class="w-full min-w-[720px] text-base">
              <thead class="bg-canvas/60">
                <tr class="border-b border-line">
                  <th scope="col" class={th}>Fecha</th>
                  <th scope="col" class={th}>Casa</th>
                  <th scope="col" class={th}>Forma y referencia</th>
                  <th scope="col" class={th}>Aplicado a</th>
                  <th scope="col" class={`${th} text-right`}>Monto</th>
                </tr>
              </thead>
              <tbody>
                {payments.rows.length === 0 && (
                  <tr><td colspan="5" class="p-8 text-center text-ink-muted">No hay pagos con estos filtros.</td></tr>
                )}
                {payments.rows.map(({ house, payment: p }) => (
                  <tr class="border-b border-line last:border-b-0 align-top hover:bg-canvas/50">
                    <td class="tabular whitespace-nowrap px-4 py-3 text-sm text-ink-muted">{date(p.date)}</td>
                    <td class="whitespace-nowrap px-4 py-3"><a href={`/admin/${condominium.slug}/casas/${house.id}#pagos`} class="font-bold text-ink no-underline hover:underline">Casa {house.number}</a></td>
                    <td class="px-4 py-3 text-sm">
                      <span class="font-bold">{PAYMENT_METHOD_LABELS[p.method]}</span>
                      {p.reference && <span class="block text-ink-muted">Ref. {p.reference}</span>}
                      {p.amountVes !== null && <span class="tabular block text-ink-muted">{formatVes(p.amountVes)}</span>}
                    </td>
                    <td class="px-4 py-3 text-sm text-ink-muted">{p.appliedTo.length ? p.appliedTo.map((a) => a.label).join(', ') : 'Saldo a favor'}</td>
                    <td class="tabular whitespace-nowrap px-4 py-3 text-right font-bold text-accent">{formatUsd(p.amount)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : cashFlow && (
        <>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-lg text-ink-muted">
              Movimientos de <strong class="text-ink">{cashFlow.label}</strong>: solo lo que pasó ese mes, no lo acumulado hasta hoy.
            </p>
            <a href={cashFlowPdfHref} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-[var(--radius-control)] border-2 border-line bg-surface px-5 text-base font-bold text-ink no-underline hover:border-line-strong">
              Ver vista previa (PDF)
            </a>
          </div>

          <SummaryStrip
            items={[
              { label: 'Saldo inicial', value: formatUsd(cashFlow.openingBalance) },
              { label: 'Ingresos', value: `+ ${formatUsd(cashFlow.incomeTotal)}`, tone: 'accent' },
              { label: 'Egresos', value: `- ${formatUsd(cashFlow.expenseTotal)}`, tone: cashFlow.expenseTotal > 0 ? 'warning' : 'default' },
              { label: 'Saldo disponible', value: formatUsd(cashFlow.closingBalance), tone: cashFlow.closingBalance < 0 ? 'warning' : 'accent' },
            ]}
          />

          <div class="grid gap-6 lg:grid-cols-2">
            <div class="flex flex-col gap-3">
              <h2 class="font-display text-2xl font-semibold text-accent-strong">Ingresos</h2>
              <div class="relative overflow-x-auto rounded-[var(--radius-card)] bg-surface shadow-[var(--shadow-raised)] ring-1 ring-line">
                <table class="w-full min-w-[480px] text-base">
                  <thead class="bg-canvas/60">
                    <tr class="border-b border-line">
                      <th scope="col" class={th}>Fecha</th>
                      <th scope="col" class={th}>Concepto</th>
                      <th scope="col" class={`${th} text-right`}>Monto</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cashFlow.payments.length === 0 && cashFlow.incomeLines.length === 0 && (
                      <tr><td colspan="3" class="p-8 text-center text-ink-muted">No hay ingresos este mes.</td></tr>
                    )}
                    {cashFlow.payments.map((p) => (
                      <tr class="border-b border-line last:border-b-0 hover:bg-canvas/50">
                        <td class="tabular whitespace-nowrap px-4 py-3 text-sm text-ink-muted">{date(p.date)}</td>
                        <td class="px-4 py-3">
                          <span class="font-bold">Casa {p.houseNumber}</span>
                          <span class="block text-xs text-ink-muted">{p.ownerName ?? ''} · Pago ({PAYMENT_METHOD_LABELS[p.method]})</span>
                        </td>
                        <td class="tabular whitespace-nowrap px-4 py-3 text-right font-bold text-accent">{formatUsd(p.amount)}</td>
                      </tr>
                    ))}
                    {cashFlow.incomeLines.map((l) => (
                      <tr class="border-b border-line last:border-b-0 hover:bg-canvas/50">
                        <td class="px-4 py-3 text-sm text-ink-muted">—</td>
                        <td class="px-4 py-3">
                          <span class="font-bold">{l.concept}</span>
                          <span class="block text-xs text-ink-muted">{l.category ?? 'Ingreso de la comunidad'}</span>
                        </td>
                        <td class="tabular whitespace-nowrap px-4 py-3 text-right font-bold text-accent">{formatUsd(l.amount)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div class="flex flex-col gap-3">
              <h2 class="font-display text-2xl font-semibold text-warning">Egresos</h2>
              <div class="relative overflow-x-auto rounded-[var(--radius-card)] bg-surface shadow-[var(--shadow-raised)] ring-1 ring-line">
                <table class="w-full min-w-[480px] text-base">
                  <thead class="bg-canvas/60">
                    <tr class="border-b border-line">
                      <th scope="col" class={th}>Concepto</th>
                      <th scope="col" class={th}>Categoría</th>
                      <th scope="col" class={`${th} text-right`}>Monto</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cashFlow.expenseLines.length === 0 && (
                      <tr><td colspan="3" class="p-8 text-center text-ink-muted">No hay gastos registrados este mes.</td></tr>
                    )}
                    {cashFlow.expenseLines.map((l) => (
                      <tr class="border-b border-line last:border-b-0 hover:bg-canvas/50">
                        <td class="px-4 py-3 font-bold">{l.concept}</td>
                        <td class="px-4 py-3 text-sm text-ink-muted">{l.category ?? '—'}</td>
                        <td class="tabular whitespace-nowrap px-4 py-3 text-right font-bold">{formatUsd(l.amount)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </>
      )
    }

    {
      view !== 'caja' && (
        <Disclosure id="exportar" icon="download" title="Exportar estado de cuenta de todas las casas" subtitle="Lo facturado y cobrado del mes elegido (no acumulado) junto al saldo pendiente real de cada casa.">
          <form method="get" action={`/api/admin/${condominium.slug}/estado-de-cuenta`} target="_blank" class="flex flex-wrap items-end gap-3">
            <FormSelect id="exp-mes" name="month" label="Mes" value={String(cashFlowMonth)} options={monthOptions.map((m) => ({ value: String(m.value), label: m.label }))} />
            <FormSelect id="exp-anio" name="year" label="Año" value={String(cashFlowYear)} options={years.map((y) => ({ value: y, label: y }))} />
            <Button type="submit" size="md" variant="secondary" class="!w-auto px-6">Ver vista previa (PDF)</Button>
          </form>
        </Disclosure>
      )
    }
  </div>
</AdminLayout>
