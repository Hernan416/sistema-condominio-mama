---
// "Anotar un pago", paso 1: elegir la casa con botones grandes (número, dueño y cuánto debe).
// Paso 2 es el formulario de pago dentro de la ficha de la casa.
import AdminLayout from '@/layouts/AdminLayout.astro';
import CondominiumHeader from '@/components/domain/CondominiumHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { getAccountService, getAppName } from '@/services/container';
import { loadAdminCondominiumPage } from '@/services/condominiums/adminPage';
import { toExchangeRateView } from '@/adapters/exchangeRateViewAdapter';
import { formatUsd } from '@/utils/currency';
import { monthsLabel } from '@/utils/months';

const page = await loadAdminCondominiumPage(Astro);
if (page instanceof Response) return page;
const { admin, condominium, condominiums, rate } = page;
const accounts = [...(await getAccountService().accountsFor(condominium.id)).values()];
---

<AdminLayout title={`Anotar un pago · ${condominium.name}`} appName={getAppName()} adminUsername={admin.username} condominiums={condominiums} activeSlug={condominium.slug} activeTab="casas">
  <CondominiumHeader
    name={condominium.name}
    slug={condominium.slug}
    city={null}
    active="casas"
    rate={toExchangeRateView(rate)}
    title="Anotar un pago"
    description="Paso 1: toque la casa que pagó. En el paso 2 escribirá el monto."
  />

  <div class="flex flex-col gap-5">
    <label class="flex max-w-md flex-col gap-2">
      <span class="text-base font-bold">Buscar por número de casa o nombre</span>
      <span class="relative">
        <Icon name="search" size={22} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-muted" />
        <input
          type="search"
          data-house-search
          placeholder="Ej.: 5 o Rodríguez"
          class="min-h-14 w-full rounded-[var(--radius-control)] border-2 border-line bg-surface pl-12 pr-4 text-lg outline-none focus:border-accent"
        />
      </span>
    </label>

    <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" data-house-list>
      {
        accounts.map(({ house, outstanding, credit, monthsOwed }) => (
          <li data-search={`${house.number} ${house.ownerName ?? ''}`.toLowerCase()}>
            <a
              href={`/admin/${condominium.slug}/casas/${house.id}?accion=pago#pagos`}
              class="flex min-h-24 items-center gap-4 rounded-[var(--radius-card)] bg-surface p-4 no-underline shadow-[var(--shadow-raised)] ring-1 ring-line transition-colors hover:ring-2 hover:ring-accent focus-visible:ring-4"
            >
              <span class="font-display inline-flex size-16 shrink-0 items-center justify-center rounded-2xl bg-sunken text-3xl font-semibold text-ink">{house.number}</span>
              <span class="flex min-w-0 flex-col">
                <span class="truncate text-lg font-bold text-ink">{house.ownerName ?? `Casa ${house.number}`}</span>
                {outstanding > 0 ? (
                  <span class="text-base font-bold text-warning">Debe {formatUsd(outstanding)}{monthsOwed > 0 ? ` · ${monthsLabel(monthsOwed)}` : ''}</span>
                ) : credit > 0 ? (
                  <span class="text-base font-bold text-accent">Tiene {formatUsd(credit)} a favor</span>
                ) : (
                  <span class="text-base font-bold text-accent">Al día</span>
                )}
              </span>
              <Icon name="arrow-right" size={22} class="ml-auto shrink-0 text-accent" />
            </a>
          </li>
        ))
      }
    </ul>
    <p data-no-results hidden class="text-lg text-ink-muted">No hay ninguna casa con ese número o nombre.</p>
  </div>
</AdminLayout>

<script>
  // Filtro instantáneo de la lista de casas.
  const input = document.querySelector<HTMLInputElement>('[data-house-search]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-house-list] > li')];
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const match = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
