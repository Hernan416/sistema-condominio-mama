---
import AdminLayout from '@/layouts/AdminLayout.astro';
import CondominiumHeader from '@/components/domain/CondominiumHeader.astro';
import UnitsEditor from '@/components/domain/UnitsEditor';
import { getAppName, getCondominiumService } from '@/services/container';
import { loadAdminCondominiumPage } from '@/services/condominiums/adminPage';
import { toExchangeRateView } from '@/adapters/exchangeRateViewAdapter';
import { toUnitDto } from '@/adapters/invoiceDtoAdapter';

const page = await loadAdminCondominiumPage(Astro);
if (page instanceof Response) return page;
const { admin, condominium, condominiums, rate } = page;
const service = getCondominiumService();
const [units, full] = await Promise.all([service.listUnits(condominium), service.getWithSettings(condominium)]);
---

<AdminLayout title={`Alícuotas · ${condominium.name}`} appName={getAppName()} adminUsername={admin.username} condominiums={condominiums} activeSlug={condominium.slug} activeTab="alicuotas">
  <CondominiumHeader
    name={condominium.name}
    slug={condominium.slug}
    city={condominium.city}
    active="alicuotas"
    rate={toExchangeRateView(rate)}
    description="La alícuota es la parte de los gastos que le toca a cada casa. Se configura una sola vez (o cuando cambie el documento del condominio)."
  />
  <UnitsEditor client:load condominiumSlug={condominium.slug} initialUnits={units.map(toUnitDto)} initialScheme={full.aliquotScheme} />
</AdminLayout>
