---
import AdminLayout from '@/layouts/AdminLayout.astro';
import CondominiumHeader from '@/components/domain/CondominiumHeader.astro';
import BillingSheetEditor from '@/components/domain/BillingSheetEditor';
import { getAppName, getBillingService, getCondominiumService } from '@/services/container';
import { loadAdminCondominiumPage } from '@/services/condominiums/adminPage';
import { toExchangeRateDto, toExchangeRateView } from '@/adapters/exchangeRateViewAdapter';
import { toBillingSheetDto, toUnitDto } from '@/adapters/invoiceDtoAdapter';
import { periodFromQuery } from '@/utils/months';

const page = await loadAdminCondominiumPage(Astro);
if (page instanceof Response) return page;
const { admin, condominium, condominiums, rate } = page;

const period = periodFromQuery(Astro.url.searchParams);
const [{ sheet, origin }, units, full] = await Promise.all([
  getBillingService().getSheet(condominium, period),
  getCondominiumService().listUnits(condominium),
  getCondominiumService().getWithSettings(condominium),
]);
---

<AdminLayout title={`Gastos · ${condominium.name}`} appName={getAppName()} adminEmail={admin.email} condominiums={condominiums} activeSlug={condominium.slug} activeTab="gastos">
  <CondominiumHeader
    name={condominium.name}
    slug={condominium.slug}
    city={condominium.city}
    active="gastos"
    stepDone={{ gastos: origin === 'saved' }}
    rate={toExchangeRateView(rate)}
    description="Cada mes se hace en dos pasos. Ahora está en el paso 1: anote lo que gastó el condominio y toque «Guardar gastos». El sistema calcula cuánto le toca a cada casa."
  />
  <BillingSheetEditor
    client:load
    condominiumSlug={condominium.slug}
    units={units.map(toUnitDto)}
    initialPeriod={period}
    initialSheet={toBillingSheetDto(sheet)}
    initialOrigin={origin}
    exchangeRate={toExchangeRateDto(rate)}
    aliquotCategories={full.aliquotScheme.categories.map(({ id, name }) => ({ id, name }))}
  />
</AdminLayout>
