# ════════════════════════════════════════════════════════════════
#  No necesitas un .env para desarrollar: por defecto todo es LOCAL.
#  Datos → .local-data/db.json · Los PDF se generan al momento (no se guardan archivos).
# ════════════════════════════════════════════════════════════════

# ── Proveedores (el único interruptor para pasar a la nube) ──────
# local | supabase
DATA_PROVIDER=local

# Marca del producto que ven residentes y administradores
APP_NAME=Portal MAGO Condominios

# ── Tasa de cambio USD → Bs. ─────────────────────────────────────
# dolarapi = tasa oficial BCV desde https://ve.dolarapi.com (gratis, sin clave)
# fixed    = una tasa fija (útil sin internet)
EXCHANGE_RATE_PROVIDER=dolarapi
# EXCHANGE_RATE_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
# EXCHANGE_RATE_FIXED=855.66
# Protege el cron diario de la tasa (/api/cron/exchange-rate). En Vercel: Settings → Environment Variables.
# CRON_SECRET=

# Firma de las cookies de sesión. Opcional en desarrollo, OBLIGATORIO en producción (mín. 32).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# ── Modo local ───────────────────────────────────────────────────
LOCAL_DATA_DIR=.local-data
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=admin1234
LOCAL_ADMIN_NAME=María González

# ── Supabase (solo si DATA_PROVIDER=supabase) ────────────────────
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # solo servidor, nunca al navegador

